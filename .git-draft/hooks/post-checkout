#!/bin/sh
# BEGIN Qoder AI tracker
previous_head="$1"
new_head="$2"
is_branch_checkout="$3"
case "$previous_head" in
  ''|*[!0]*) is_zero_head="0" ;;
  *) is_zero_head="1" ;;
esac
if [ "$is_branch_checkout" = "1" ] && [ "$previous_head" != "$new_head" ] && [ "$is_zero_head" = "0" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -W 2>/dev/null || pwd)"
  ELECTRON_RUN_AS_NODE=1 "C:/Users/31058/AppData/Local/Programs/Qoder CN/Qoder CN.exe" "C:/Users/31058/AppData/Local/Programs/Qoder CN/resources/app.asar.unpacked/node_modules/@qoder-ai/qoder-cn-agent-sdk/dist/_worker/qoder-worker-runtime.obf.mjs" ai-code-tracking-hook post-checkout --workspace "$repo_root" --old-head "$previous_head" --new-head "$new_head" --is-branch "$is_branch_checkout" >/dev/null 2>&1 || true
fi
# END Qoder AI tracker
